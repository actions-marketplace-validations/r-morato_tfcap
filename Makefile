.PHONY: build test lint demo docs

build:
	go build -o tfcap ./cmd/tfcap

test:
	go test -race ./...

lint:
	gofmt -l . && go vet ./...

demo: build
	./tfcap diff examples/upgrade-attack/before examples/upgrade-attack/after || true

docs:
	go run ./cmd/tfcap rules --format markdown > docs/rules.md.tmp
	{ echo "# Rules"; echo; echo "Generated by \`make docs\`. Severity is the default; some findings are raised to critical when several indicators combine."; echo; cat docs/rules.md.tmp; } > docs/rules.md
	rm docs/rules.md.tmp
